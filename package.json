{
  "name": "credit-dashboard-sut",
  "version": "0.0.0",
  "private": true,
  "description": "Fictional UK credit-health dashboard built as a system under test. Repository-level tooling.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "verify": "node tools/verify.mjs",
    "mock": "prism mock DOCS/.architecture/openapi.yaml -p 4010 --errors",
    "check:mock": "node tools/mock-smoke.mjs",
    "check:client": "npm --prefix packages/api-client run check",
    "check:client-smoke": "node tools/client-smoke.ts",
    "generate:service-contract": "node tools/generate-service-contract.mjs",
    "check:service-contract": "node tools/generate-service-contract.mjs --check",
    "check:service": "dotnet test demo-apps/demoapp001-dotnet-api/CreditDashboard.sln -c Release --nologo",
    "service": "dotnet run --project demo-apps/demoapp001-dotnet-api/CreditDashboard.Api",
    "kanban": "generate-kanban --project credit-dashboard-sut --dialect auth-table --backlog DOCS/backlog.md",
    "check:kanban": "generate-kanban --check --project credit-dashboard-sut --dialect auth-table --backlog DOCS/backlog.md"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "portfolio-kanban-generator": "1.2.0",
    "yaml": "2.9.1"
  }
}
