{
  "name": "@cds/harness-serenity",
  "version": "0.1.0",
  "private": true,
  "description": "Serenity/JS harness driving features-shared/ against the credit-dashboard-sut service (CDS-22, DR-042).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --import tsx --test src/contract/validate.test.ts src/unit/parallel.test.ts src/flags/verdict.test.ts src/visual/cases.test.ts src/flags/reset.test.ts src/report/checks.test.ts src/report/site.test.ts src/report/switch.test.ts src/report/files.test.ts src/report/manifest.test.ts",
    "test:api": "node scripts/run.mjs api",
    "test:ui": "node scripts/run.mjs ui",
    "test:exit": "node scripts/run.mjs exit",
    "test:flags": "node scripts/run.mjs flags",
    "test:visual": "node scripts/run.mjs visual",
    "report": "node scripts/report.mjs",
    "check:report": "node --import tsx scripts/check-report.ts",
    "test:rules": "node --import tsx --test src/exit/semantic-rules.test.ts",
    "check:site": "node --import tsx scripts/check-site.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.64.0",
    "@serenity-js/assertions": "3.49.0",
    "@serenity-js/console-reporter": "3.49.0",
    "@serenity-js/core": "3.49.0",
    "@serenity-js/cucumber": "3.49.0",
    "@serenity-js/playwright": "3.49.0",
    "@serenity-js/serenity-bdd": "3.49.0",
    "@serenity-js/web": "3.49.0",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
